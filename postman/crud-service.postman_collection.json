{
  "info": {
    "_postman_id": "d37367a4-b4c7-468a-aa31-b45f8be3d760",
    "name": "CRUD Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requests for the crud-service Express app."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3003"
    },
    {
      "key": "recordId",
      "value": "replace-with-mongo-id"
    }
  ],
  "item": [
    {
      "name": "Create Saved Record",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lastPrompt\": \"Write a product slogan for a weather dashboard.\",\n  \"result\": \"Your forecast, beautifully simplified.\",\n  \"type\": \"text\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/data",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "data"
          ]
        },
        "description": "Save a generated text or image result."
      },
      "response": []
    },
    {
      "name": "Get All Saved Records",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/data",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "data"
          ]
        },
        "description": "Fetch all saved records."
      },
      "response": []
    },
    {
      "name": "Delete All Saved Records",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/data",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "data"
          ]
        },
        "description": "Delete every saved record."
      },
      "response": []
    },
    {
      "name": "Delete Saved Record By ID",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/data/{{recordId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "data",
            "{{recordId}}"
          ]
        },
        "description": "Delete one saved record using its MongoDB document id."
      },
      "response": []
    }
  ]
}
